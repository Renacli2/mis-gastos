<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget "Próximos vencimientos" (4x2). Tres filas fijas: VencimientosWidget.java las llena, esconde las
  que sobran y elige cuántas entran según el alto. Los textos de ejemplo se ven en el selector de widgets.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/w_cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_nombre"
            android:textColor="@color/w_tinta"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_ver_todos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_ver_todos"
            android:textColor="@color/w_enlace"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Fila 1 -->
    <LinearLayout
        android:id="@+id/w_fila1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/w_tilde1"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_tilde_urgente"
            android:contentDescription="Pagar" />

        <LinearLayout
            android:id="@+id/w_txt1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/w_nombre1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Celular"
                    android:textColor="@color/w_tinta"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_estado1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_rojo"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="Venció ayer"
                    android:textColor="@color/w_coral"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_sub1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="18/11 · Mercado Pago"
                android:textColor="@color/w_tinta2"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_ocultar1"
            style="@style/WidgetOcultar" />
    </LinearLayout>

    <!-- Fila 2 -->
    <LinearLayout
        android:id="@+id/w_fila2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/w_tilde2"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_tilde_urgente"
            android:contentDescription="Pagar" />

        <LinearLayout
            android:id="@+id/w_txt2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/w_nombre2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Expensas"
                    android:textColor="@color/w_tinta"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_estado2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_rojo"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="Vence hoy"
                    android:textColor="@color/w_coral"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_sub2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="19/11 · Rapipago · Efectivo"
                android:textColor="@color/w_tinta2"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_ocultar2"
            style="@style/WidgetOcultar" />
    </LinearLayout>

    <!-- Fila 3 -->
    <LinearLayout
        android:id="@+id/w_fila3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/w_tilde3"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_tilde"
            android:contentDescription="Pagar" />

        <LinearLayout
            android:id="@+id/w_txt3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/w_nombre3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Patente auto"
                    android:textColor="@color/w_tinta"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_estado3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_ambar"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="Vence mañana"
                    android:textColor="@color/w_tinta"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_sub3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="20/11 · Homebanking · Débito"
                android:textColor="@color/w_tinta2"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_ocultar3"
            style="@style/WidgetOcultar" />
    </LinearLayout>

    <!-- Estados sin filas: sin servicios, al día, o nunca se abrió la app -->
    <TextView
        android:id="@+id/w_vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/w_tinta2"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- "y 2 más" / "Abrí la app para actualizar" -->
    <TextView
        android:id="@+id/w_pie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="@color/w_tinta2"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
